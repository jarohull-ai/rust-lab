{
  "graph_version": "0.1",
  "nodes": [
    {
      "id": "flags",
      "kind": "json_parse",
      "config": { "json_str": "{\"user\": {\"is_admin\": false}}", "path": "user.is_admin" }
    },
    {
      "id": "as_bool",
      "kind": "json_to_bool",
      "config": {}
    },
    {
      "id": "check",
      "kind": "condition",
      "config": { "true_branch": "welcome-admin", "false_branch": "wait" }
    },
    {
      "id": "welcome-admin",
      "kind": "log_output",
      "config": { "text": "Welcome, admin!" }
    },
    {
      "id": "wait",
      "kind": "delay",
      "config": { "duration": "500ms" }
    },
    {
      "id": "welcome-user",
      "kind": "log_output",
      "config": { "text": "Welcome, user (after 500ms)." },
      "after": ["wait"]
    },
    {
      "id": "done",
      "kind": "log_output",
      "config": { "text": "Finished - this node always runs." }
    }
  ],
  "edges": [
    { "from": { "node": "flags", "port": "value" }, "to": { "node": "as_bool", "port": "value" } },
    { "from": { "node": "as_bool", "port": "value" }, "to": { "node": "check", "port": "value" } }
  ]
}
